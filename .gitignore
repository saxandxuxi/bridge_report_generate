# ---------- Python / IDE / 系统 ----------
.venv/
__pycache__/
*.pyc
.idea/
.vscode/
.DS_Store
Thumbs.db
Desktop.ini
~$*
*.bak

# ---------- 本地工具/环境 ----------
.workbuddy/
.env
.env.*
!.env.example

# ---------- 日志 ----------
*.log

# ---------- 运行时产物（不推送到服务器） ----------
outputs/
data/*.csv
!data/.gitkeep

# ---------- 桥数据预处理产物（可在服务器重新生成） ----------
preprocess/图库/
preprocess/统计值/
preprocess/日级数据/
preprocess/*.csv
preprocess/*.log
preprocess/status.json
preprocess/sensor_ids.txt

# ---------- 离线依赖（有意保留，勿忽略） ----------
# vendor/（numpy/matplotlib/pandas 等）与 .deps/（docx/pymupdf 等）
# 是随代码一起部署到服务器、免联网安装的内嵌依赖，必须提交。
